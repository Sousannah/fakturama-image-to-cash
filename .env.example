# Copy to .env and fill in. Only the first three lines are required.

# --- extraction -------------------------------------------------------------
F2C_PROVIDER=groq                 # groq | anthropic
GROQ_API_KEY=gsk_...
F2C_MODEL=openai/gpt-oss-120b

# OCR first (default), or hand the image straight to a multimodal model.
# F2C_EXTRACTION_MODE=ocr          # ocr | vision
# F2C_OCR_ENGINE=auto              # auto | easyocr | tesseract

# Only needed for F2C_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# --- the application under automation ---------------------------------------
F2C_FAKTURAMA_EXE=C:\Program Files\Fakturama2\Fakturama.exe

# The workspace Fakturama's own title bar names ("Fakturama - D:\"), i.e. the
# folder that holds Database/ and Templates/ - NOT the install directory.
F2C_WORKSPACE=C:\Users\<you>\Fakturama2
